# Public address of the site (used in email links).
BASE_URL=https://lettertide.onrender.com
# Free hosted database (Turso). Leave empty locally to use a file in ./data
DATABASE_URL=libsql://lettertide-yourname.turso.io
DATABASE_TOKEN=
# Free email sending through a Google Apps Script on your Gmail (see google-apps-script/send-mail.gs)
MAIL_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
MAIL_WEBHOOK_SECRET=
# Secret for the free scheduler that calls /api/cron/deliver every 10 minutes
CRON_SECRET=
# Optional alternatives / extras
SMTP_URL=
ANTHROPIC_API_KEY=

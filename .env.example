# Public address of the site (used in email links). Must be https in production.
BASE_URL=https://lettertide.example.com
PORT=3000
# SMTP connection string from your email provider. Leave empty to print emails to the console.
SMTP_URL=smtps://username:password@smtp.provider.com:465
MAIL_FROM=Lettertide <letters@lettertide.example.com>
# Where the SQLite database lives. Put it on a persistent disk and back it up.
DB_PATH=./data/lettertide.db
# Optional: lets Claude write personal Santa replies (otherwise a template is used)
ANTHROPIC_API_KEY=
SANTA_MODEL=claude-haiku-5-5
